# Local backend development with PostgreSQL.
DATABASE_URL=postgresql+psycopg://evenly:evenly@localhost:5432/evenly

# Docker Compose settings. Compose uses these to build the internal URL for
# the postgres service; do not commit a real password here.
POSTGRES_DB=evenly
POSTGRES_USER=evenly
POSTGRES_PASSWORD=change-me-locally

# Local-only demo data. Keep false/unset in production.
SEED_DEMO_DATA=true

# Persistent local receipt directory. Use a persistent volume or object
# storage adapter for production deployments.
RECEIPT_STORAGE_DIR=.evenly-receipts
