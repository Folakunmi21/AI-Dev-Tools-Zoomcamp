# Alembic and the backend use this same URL. From backend/, run:
#   uv run alembic upgrade head
# Local backend development with PostgreSQL.
DATABASE_URL=postgresql+psycopg://evenly:evenly@localhost:5432/evenly
# For Render + Supabase, set DATABASE_URL to the Supabase PostgreSQL URL in
# the Render dashboard. Do not commit that value here.

# Docker Compose settings. Compose uses these to build the internal URL for
# the postgres service; do not commit a real password here.
POSTGRES_DB=evenly
POSTGRES_USER=evenly
POSTGRES_PASSWORD=change-me-locally

# Local-only demo data. Keep false/unset in production. Migrations never seed data.
SEED_DEMO_DATA=true

# Persistent local receipt directory. Use a persistent volume or object
# storage adapter for production deployments.
RECEIPT_STORAGE_DIR=.evenly-receipts

# OpenTelemetry resource attributes and optional OTLP trace/metric export.
APP_ENV=development
APP_VERSION=0.1.0
# These resource attributes are included on traces and application metrics.
# OTEL_SERVICE_NAME=evenly-backend
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
# For the application container in root docker-compose.yaml, use:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# Render development and production require an externally reachable Collector.
